<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ionia_inv_panel_view_form" model="ir.ui.view">
        <field name="name">ionia.inv.panel.form</field>
        <field name="model">ionia.inv.panel</field>
        <field name="arch" type="xml">
            <form string="Tablero económico">
                <sheet>
                    <div class="oe_title mb-2">
                        <h1 class="mb-0">Tablero económico de pozos</h1>
                        <div class="text-muted">Prioridad en divisa (USD) · equivalente en Bs a tasa viva</div>
                    </div>
                    <h5 class="text-muted text-uppercase mt-3 mb-2">Rentabilidad</h5>
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6"><div class="card h-100 border-0 shadow-sm"><div class="card-body text-center py-4">
                            <i class="fa fa-arrow-up fa-2x text-success mb-2"/>
                            <div class="text-muted text-uppercase" style="font-size:11px">Ingreso global</div>
                            <div class="text-success" style="font-size:24px;font-weight:600">$ <field name="ingreso_global" nolabel="1"/></div>
                            <div class="text-muted" style="font-size:12px">Bs <field name="ingreso_global_bs" nolabel="1"/></div>
                        </div></div></div>
                        <div class="col-lg-3 col-md-6"><div class="card h-100 border-0 shadow-sm"><div class="card-body text-center py-4">
                            <i class="fa fa-arrow-down fa-2x text-danger mb-2"/>
                            <div class="text-muted text-uppercase" style="font-size:11px">Costo global</div>
                            <div class="text-danger" style="font-size:24px;font-weight:600">$ <field name="costo_global" nolabel="1"/></div>
                            <div class="text-muted" style="font-size:12px">Bs <field name="costo_global_bs" nolabel="1"/></div>
                        </div></div></div>
                        <div class="col-lg-3 col-md-6"><div class="card h-100 border-0 shadow-sm"><div class="card-body text-center py-4">
                            <i class="fa fa-line-chart fa-2x text-primary mb-2"/>
                            <div class="text-muted text-uppercase" style="font-size:11px">Margen global</div>
                            <div class="text-primary" style="font-size:24px;font-weight:600">$ <field name="margen_global" nolabel="1"/></div>
                            <div class="text-muted" style="font-size:12px">Bs <field name="margen_global_bs" nolabel="1"/></div>
                            <div class="mt-1"><span class="badge rounded-pill text-bg-primary"><field name="margen_global_pct" nolabel="1"/> %</span></div>
                        </div></div></div>
                        <div class="col-lg-3 col-md-6"><div class="card h-100 border-0 shadow-sm"><div class="card-body text-center py-4">
                            <i class="fa fa-cubes fa-2x text-info mb-2"/>
                            <div class="text-muted text-uppercase" style="font-size:11px">Valor stock mant. (Bs)</div>
                            <div class="text-info" style="font-size:26px;font-weight:600"><field name="stock_valor_mant" nolabel="1"/></div>
                        </div></div></div>
                    </div>
                    <h5 class="text-muted text-uppercase mt-4 mb-2">Operación</h5>
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6"><div class="card h-100 border-0 shadow-sm"><div class="card-body text-center py-4">
                            <i class="fa fa-tint fa-2x text-primary mb-2"/><div class="text-muted text-uppercase" style="font-size:11px">Pozos</div>
                            <div class="text-primary" style="font-size:26px;font-weight:600"><field name="n_pozos" nolabel="1"/></div></div></div></div>
                        <div class="col-lg-3 col-md-6"><div class="card h-100 border-0 shadow-sm"><div class="card-body text-center py-4">
                            <i class="fa fa-check-circle fa-2x text-success mb-2"/><div class="text-muted text-uppercase" style="font-size:11px">Activos</div>
                            <div class="text-success" style="font-size:26px;font-weight:600"><field name="n_activos" nolabel="1"/></div></div></div></div>
                        <div class="col-lg-3 col-md-6"><div class="card h-100 border-0 shadow-sm"><div class="card-body text-center py-4">
                            <i class="fa fa-pause-circle fa-2x text-warning mb-2"/><div class="text-muted text-uppercase" style="font-size:11px">En pausa</div>
                            <div class="text-warning" style="font-size:26px;font-weight:600"><field name="n_pausa" nolabel="1"/></div></div></div></div>
                        <div class="col-lg-3 col-md-6"><div class="card h-100 border-0 shadow-sm"><div class="card-body text-center py-4">
                            <i class="fa fa-exclamation-triangle fa-2x text-danger mb-2"/><div class="text-muted text-uppercase" style="font-size:11px">Fallas abiertas</div>
                            <div class="text-danger" style="font-size:26px;font-weight:600"><field name="n_fallas" nolabel="1"/></div></div></div></div>
                    </div>
                    <h5 class="text-muted text-uppercase mt-4 mb-2">Compras de mantenimiento</h5>
                    <div class="row g-3">
                        <div class="col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body text-center py-4">
                            <i class="fa fa-shopping-cart fa-2x text-dark mb-2"/><div class="text-muted text-uppercase" style="font-size:11px">Gastos de repuestos (Bs)</div>
                            <div class="text-dark" style="font-size:26px;font-weight:600"><field name="gastos_compra_mant" nolabel="1"/></div></div></div></div>
                        <div class="col-lg-8 d-flex align-items-center">
                            <button name="%(action_ionia_pozo_rentabilidad)d" type="action" class="btn btn-primary" string="Ver rentabilidad por pozo (gráfico)"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ionia_inv_panel" model="ir.actions.act_window">
        <field name="name">Tablero económico</field>
        <field name="res_model">ionia.inv.panel</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ionia_inv_panel_view_form"/>
        <field name="target">current</field>
    </record>
</odoo>
