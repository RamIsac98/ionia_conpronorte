<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Equipo: campos de horas/costo -->
    <record id="maintenance_equipment_form_ionia" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.ionia</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Mantenimiento por horas (Ionia)">
                    <field name="horas_actual"/>
                    <field name="horas_intervalo"/>
                    <field name="horas_por_dia"/>
                    <field name="coste_mant_acum" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Orden: pozo, horas, costo, nota y repuestos -->
    <record id="maintenance_request_form_ionia" model="ir.ui.view">
        <field name="name">maintenance.request.form.ionia</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Ubicación y costo (Ionia)">
                    <field name="pozo_id" readonly="1"/>
                    <field name="horas_uso" readonly="1"/>
                    <field name="fecha_prox_mant" readonly="1"/>
                    <field name="coste_total" readonly="1"/>
                </group>
                <group string="Cambio de repuestos">
                    <field name="nota_repuestos" nolabel="1" placeholder="Notas del cambio de repuestos..."/>
                    <field name="repuesto_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="subtotal" readonly="1"/>
                            <field name="consumido" readonly="1"/>
                        </list>
                    </field>
                    <button name="action_consumir_repuestos" type="object"
                            string="Descontar repuestos del stock" class="oe_highlight"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Lista de órdenes -->
    <record id="maintenance_request_list_ionia" model="ir.ui.view">
        <field name="name">maintenance.request.list.ionia</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <list string="Órdenes de mantenimiento">
                <field name="equipment_id"/>
                <field name="maintenance_type"/>
                <field name="stage_id"/>
                <field name="pozo_id"/>
                <field name="horas_uso" optional="show"/>
                <field name="fecha_prox_mant" string="Próximo mantenimiento" optional="show"/>
                <field name="coste_total" optional="show"/>
                <field name="nota_repuestos" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="maintenance_request_search_ionia" model="ir.ui.view">
        <field name="name">maintenance.request.search.ionia</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <search string="Órdenes de mantenimiento">
                <field name="equipment_id"/>
                <field name="pozo_id"/>
                <filter name="f_falla" string="Reportes de falla (correctivo)" domain="[('maintenance_type','=','corrective')]"/>
                <filter name="f_prev" string="Órdenes (preventivo)" domain="[('maintenance_type','=','preventive')]"/>
                <separator/>
                <filter name="g_pozo" string="Pozo" context="{'group_by':'pozo_id'}"/>
                <filter name="g_tipo" string="Tipo" context="{'group_by':'maintenance_type'}"/>
                <filter name="g_stage" string="Etapa" context="{'group_by':'stage_id'}"/>
                <searchpanel>
                    <field name="pozo_id" string="Pozo" icon="fa-tint" enable_counters="1"/>
                    <field name="maintenance_type" string="Tipo" icon="fa-wrench" enable_counters="1" select="multi"/>
                    <field name="stage_id" string="Etapa" icon="fa-tasks" enable_counters="1" select="multi"/>
                    <field name="equipment_id" string="Equipo" icon="fa-cog" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_ionia_maint_orden" model="ir.actions.act_window">
        <field name="name">Órdenes de mantenimiento</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="maintenance_request_list_ionia"/>
        <field name="search_view_id" ref="maintenance_request_search_ionia"/>
    </record>
</odoo>
