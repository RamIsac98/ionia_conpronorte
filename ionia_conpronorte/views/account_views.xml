<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_ionia" model="ir.ui.view">
        <field name="name">sale.order.form.ionia.usd</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group class="oe_subtotal_footer">
                    <field name="total_usd" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_ionia" model="ir.ui.view">
        <field name="name">purchase.order.form.ionia.usd</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group class="oe_subtotal_footer">
                    <field name="total_usd" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="account_move_form_ionia" model="ir.ui.view">
        <field name="name">account.move.form.ionia.usd</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group class="oe_subtotal_footer">
                    <field name="total_usd" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
